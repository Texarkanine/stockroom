{"c":[{"name":"20260913T191535Z-13e9bab5c49f07d0","text":"uv lock --locked without --refresh treats a pytorch-index lock as current; root docs lock must use --no-config --refresh.","type":"note"},{"name":"20261002T193807Z-4efc5d97f1279b70","text":"stockroom semantic tsv and table include session_id and message_id; do not document JSON as the only shape that can hand off to query.","type":"note"}]}
